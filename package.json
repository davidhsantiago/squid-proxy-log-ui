{
  "name": "squid-proxy-log-ui",
  "version": "1.0.0",
  "description": "A simple log web based log viewer for squid",
  "keywords": [
    "logviewer"
  ],
  "homepage": "https://github.com/davidhsantiago/squid-proxy-log-ui#readme",
  "bugs": {
    "url": "https://github.com/davidhsantiago/squid-proxy-log-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidhsantiago/squid-proxy-log-ui.git"
  },
  "license": "MIT",
  "author": "David Santiago Hochfellner",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "clean:dist": "rm -rf dist",
    "clean:modules": "rm -rf node_modules",
    "clean": "npm run clean:dist && npm run clean:modules",
    "test": "node --test",
    "fetchDependencies": "node ./scripts/extractModules.js",
    "assets:vendor": "node scripts/copyVendorAssets.js",
    "postinstall": "npm run assets:vendor",
    "prestart": "npm run assets:vendor",
    "predev": "npm run assets:vendor"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "axios": "^1.21.0",
    "bootstrap-icons": "^1.10.5",
    "dotenv": "^18.0.9",
    "ws": "^8.22.0"
  }
}
